# Path to the trained model checkpoint
CHECKPOINT_PATH=./checkpoints/vsr_model_best.pth
# Inference device: cuda (GPU server) or cpu
DEVICE=cuda
# Maximum supported input height.
MAX_INPUT_HEIGHT=480
# What to do with taller input: reject (default, fails the job with a clear
# error), downscale (resize to MAX_INPUT_HEIGHT, aspect preserved), or native
# (run at full resolution — 4x output, very VRAM-hungry).
HIGH_RES_POLICY=reject
HOST=0.0.0.0
PORT=8000
# REQUIRED in remote mode: shared secret for internal backend->AI calls. Use a
# strong random value and keep it identical to the backend's AI_INTERNAL_TOKEN.
AI_INTERNAL_TOKEN=change-me
# Working directories for the remote transport (uploaded inputs and enhanced
# outputs), resolved relative to apps/ai (absolute paths also work).
WORK_UPLOAD_DIR=../../storage/ai/uploads
WORK_RESULT_DIR=../../storage/ai/results
# Progressive preview frames written during inference (sampled enhanced JPEGs).
PREVIEW_ENABLED=true
# Playback stride: 2 gives a 15 fps flipbook at a 30 fps source. Raise it
# (e.g. 15) to fall back to sparse still-frame sampling.
PREVIEW_EVERY_N_FRAMES=2
PREVIEW_MAX_WIDTH=640
PREVIEW_JPEG_QUALITY=80
WORK_PREVIEW_DIR=/opt/upscale/storage/ai/previews
