NODE_ENV=production
PORT=3000
# Never use `*` in production. Set a comma-separated allowlist of exact origins:
CORS_ORIGIN=https://upscale.example.com
# Base URL of the Python FastAPI inference service (apps/ai)
AI_SERVICE_URL=http://localhost:8000
# Storage directories, resolved relative to apps/backend (absolute paths recommended in prod)
UPLOAD_DIR=../../storage/uploads
RESULT_DIR=../../storage/results
MAX_FILE_SIZE_MB=500
ALLOWED_VIDEO_EXTENSIONS=.mp4,.avi,.mkv,.mov,.wmv,.webm
