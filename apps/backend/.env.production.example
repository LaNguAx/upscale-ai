NODE_ENV=production
PORT=3000
# Never use `*` in production. Set a comma-separated allowlist of exact origins:
CORS_ORIGIN=https://upscale.example.com
# Base URL of the Python FastAPI inference service (apps/ai).
# In a two-server deployment the AI service runs on the GPU host — point this at
# its internal address (placeholder; the real host is set by infra at deploy):
AI_SERVICE_URL=http://<gpu-server-host>:8000
# Two-server deployments have no shared storage, so use the remote transport:
# the backend uploads the video to the AI service and downloads the result.
AI_TRANSFER_MODE=remote
# REQUIRED in remote mode: shared secret for internal backend->AI calls. Use a
# strong random value and keep it identical to the AI service's AI_INTERNAL_TOKEN.
AI_INTERNAL_TOKEN=change-me
# Storage directories (absolute paths recommended in prod).
UPLOAD_DIR=/opt/upscale/storage/uploads
RESULT_DIR=/opt/upscale/storage/results
# Recommended small cap for the public demo.
MAX_FILE_SIZE_MB=20
ALLOWED_VIDEO_EXTENSIONS=.mp4,.avi,.mkv,.mov,.wmv,.webm
