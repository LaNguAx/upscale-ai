NODE_ENV=development
PORT=3000
# Allowed CORS origins. `*` = allow all (dev default).
# For real deploys, set a comma-separated allowlist of exact origins:
#   CORS_ORIGIN=https://upscale.example.com
CORS_ORIGIN=*
# Base URL of the Python FastAPI inference service (apps/ai)
AI_SERVICE_URL=http://localhost:8000
# How the backend hands work to the AI service:
#   path   = send absolute filesystem paths to /process (same machine / shared
#            volume — the local/dev default).
#   remote = upload the video to /process-upload and download the result back
#            (two-server deployments with no shared storage).
AI_TRANSFER_MODE=path
# Shared secret for internal backend->AI calls. Empty disables auth (dev only).
# When set, the backend sends `Authorization: Bearer <token>` to the AI's
# mutating/result endpoints. Must match the AI service's AI_INTERNAL_TOKEN.
AI_INTERNAL_TOKEN=
# Storage directories, resolved relative to apps/backend (absolute paths also work)
UPLOAD_DIR=../../storage/uploads
RESULT_DIR=../../storage/results
MAX_FILE_SIZE_MB=500
ALLOWED_VIDEO_EXTENSIONS=.mp4,.avi,.mkv,.mov,.wmv,.webm
